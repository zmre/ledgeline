{
    "name": "web",
    "private": true,
    "version": "0.2.1",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "prettier --check . && eslint .",
        "format": "prettier --write .",
        "test:unit": "vitest run",
        "test:node": "vitest run --project=unit",
        "test:components": "vitest run --project=components",
        "test": "bun run test:unit && bun run test:e2e",
        "test:e2e": "playwright test"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "1.64.1",
        "@sveltejs/adapter-static": "^4.0.1",
        "@sveltejs/kit": "^3.1.1",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/svelte": "^5.4.2",
        "@types/node": "^24.19.2",
        "daisyui": "^5.7.50",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.23.1",
        "globals": "^17.13.0",
        "jsdom": "^30.1.3",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "svelte": "^5.57.3",
        "svelte-check": "^4.7.7",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "dependencies": {
        "exceljs": "^4.4.0",
        "layerchart": "^2.9.2"
    },
    "overrides": {
        "uuid": "^11.1.1"
    },
    "imports": {
        "#lib": "./src/lib/index.js",
        "#lib/*": "./src/lib/*"
    }
}
