{
    "extends": "$app/tsconfig",
    "compilerOptions": {
        "rewriteRelativeImportExtensions": true,
        "sourceMap": true,
        "strict": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true
    },
    "include": ["src", "vite.config.ts", "playwright.config.ts", "playwright.docs.config.ts", "docs-screenshots"]
}
