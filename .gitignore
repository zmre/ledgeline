# Nix / direnv
.direnv/
result

# Rust engine (crates/)
# Covers the generated performance corpus (target/perf/*.journal, up to 26 MB
# each) and criterion's reports (target/criterion/). Both are reproducible from
# scratch — see docs/perf-baseline.md — so neither belongs in git.
/target/

# JS / SvelteKit (web/)
node_modules/
.svelte-kit/
build/
dist/
*.tsbuildinfo
.bun/

# ...except this one, which is a FIXTURE and not a dependency tree. The
# import-rules discovery scan refuses to descend into `node_modules/`, and
# fixtures/rules/tree/node_modules/dep.rules is the committed proof of it. The
# negation has to name the directory: git cannot re-include a file whose parent
# directory is excluded.
!fixtures/rules/tree/node_modules/

# Testing
test-results/
playwright-report/
coverage/

# The Imports suites write their own rules files here, drive a SAVE against
# them, and remove them afterwards. They have to live under fixtures/ because
# that directory is the discovery scan root for the journal those suites run the
# engine over — and they have to be scratch, because the alternative is a test
# that rewrites a committed fixture and leaves the tree dirty. Ignored so a
# crashed run cannot pollute git status.
/fixtures/scratch/

# Editor / OS
.DS_Store
*.swp
.idea/
