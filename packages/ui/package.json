{
    "name": "@ledgeline/ui",
    "private": true,
    "type": "module",
    "description": "The look and plumbing Ledgeline's SPAs share: themes, UI scale, breakpoints, generic components, the API token/fetch base and the native bridge. Shipped as source; each app's vite/svelte build compiles it.",
    "scripts": {
        "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
        "lint": "prettier --check . && eslint .",
        "format": "prettier --write .",
        "test:unit": "vitest run",
        "test:node": "vitest run --project=unit",
        "test:components": "vitest run --project=components"
    },
    "exports": {
        "./theme.css": "./src/theme.css",
        "./*": "./src/*"
    },
    "imports": {
        "#ui/*": "./src/*"
    },
    "peerDependencies": {
        "daisyui": "^5.7.50",
        "svelte": "^5.57.3",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@testing-library/svelte": "^5.4.2",
        "@types/node": "^24.19.2",
        "daisyui": "^5.7.50",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.23.1",
        "globals": "^17.13.0",
        "jsdom": "^30.1.3",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "svelte": "^5.57.3",
        "svelte-check": "^4.7.7",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    }
}
