{
    "extends": "$app/tsconfig",
    "compilerOptions": {
        "rewriteRelativeImportExtensions": true,
        "sourceMap": true,
        "strict": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true
    },
    "include": ["src", "e2e", "vite.config.ts", "playwright.config.ts", "eslint.config.js"]
}
