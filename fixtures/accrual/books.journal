; Accrual fixture books — synthetic data for plan 45 (accrual recognition).
; Every name and figure here is invented. Clock: 2026-11-17.
commodity $1,000.00

account assets:bank:checking            ; type: C
account assets:accounts receivable      ; type: A, kpi: receivable
account assets:prepaid                  ; type: A, kpi: prepaid
account liabilities:accounts payable    ; type: L, kpi: payable
account liabilities:deferred-revenue    ; type: L, kpi: deferred-revenue
account revenue:sales                   ; type: R
account revenue:subscriptions           ; type: R, kpi: recurring
account revenue:support                 ; type: R
account revenue:onboarding              ; type: R
account revenue:setup                   ; type: R
account revenue:services                ; type: R
account expenses:insurance:d-and-o      ; type: X
account expenses:insurance:e-and-o      ; type: X
