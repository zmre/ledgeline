        [
          "mixto:uno",
          "R"
        ],
        [
          "mixto:dos",
          "X"
        ]
      ],
      "account": "mixto",
      "type": null,
      "isRevenue": false,
      "isExpense": false,
      "isAsset": false,
      "isEquity": false
    },
    {
      "_why": "The descendant step runs AFTER inference, so a conventional root keeps its conventional meaning rather than picking up a child's subtype.",
