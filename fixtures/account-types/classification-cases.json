  "cases": [
    {
      "_why": "THE REPORTED BUG. An expense declared with a spelling the browser did not take, under a revenue-NAMED root: the declaration is dropped, name inference says revenue, and the Projections table negates the amount.",
      "declared": [
        [
          "income:contractors",
          "expenses"
        ]
      ],
      "account": "income:contractors",
      "type": "expense",
      "isRevenue": false,
      "isExpense": true,
      "isAsset": false,
      "isEquity": false
    },
    {
      "_why": "The same shape, with the revenue verdict coming from a declared ANCESTOR rather than from the name.",
      "declared": [
        [
          "ingresos",
          "R"
        ],
        [
          "ingresos:nomina",
          "expenses"
        ]
      ],
      "account": "ingresos:nomina",
      "type": "expense",
      "isRevenue": false,
      "isExpense": true,
      "isAsset": false,
      "isEquity": false
    },
    {
      "_why": "and its sibling still reads as revenue from the ancestor",
      "declared": [
        [
          "ingresos",
          "R"
        ],
        [
          "ingresos:nomina",
          "expenses"
        ]
      ],
      "account": "ingresos:consultoria",
      "type": "revenue",
      "isRevenue": true,
      "isExpense": false,
      "isAsset": false,
      "isEquity": false
    },
    {
      "_why": "Step 1 — an account's OWN declaration wins over everything, including its name.",
      "declared": [
        [
          "expenses:refunds",
          "R"
        ]
      ],
      "account": "expenses:refunds",
      "type": "revenue",
      "isRevenue": true,
      "isExpense": false,
      "isAsset": false,
      "isEquity": false
    },
    {
      "_why": "Step 2 — the nearest declared ANCESTOR, for an undeclared child.",
      "declared": [
        [
          "cogs",
          "X"
        ]
      ],
      "account": "cogs:nomina:sueldos",
      "type": "expense",
      "isRevenue": false,
      "isExpense": true,
      "isAsset": false,
      "isEquity": false
    },
    {
      "_why": "Step 3 — name inference, when nothing in the ancestry is declared.",
      "declared": [],
      "account": "expenses:payroll",
      "type": "expense",
      "isRevenue": false,
      "isExpense": true,
      "isAsset": false,
      "isEquity": false
    },
    {
      "_why": "…and a root no English heuristic knows is simply untyped, in no section at all.",
      "declared": [],
      "account": "cogs:nomina",
      "type": null,
      "isRevenue": false,
      "isExpense": false,
      "isAsset": false,
      "isEquity": false
    },
    {
      "_why": "Step 4 — an agreeing declared DESCENDANT, for the synthetic parent rows a depth-clamped report invents. The projection seed clamps to depth 2, so `ingresos:consultoria` here is a row a user really does edit.",
      "declared": [
        [
          "ingresos:consultoria:acme",
          "R"
        ],
        [
          "ingresos:consultoria:beta",
          "R"
        ]
      ],
      "account": "ingresos:consultoria",
      "type": "revenue",
      "isRevenue": true,
      "isExpense": false,
      "isAsset": false,
      "isEquity": false
    },
    {
      "_why": "The descendant step folds subtypes: a revenue and a gain agree on revenue.",
      "declared": [
        [
          "ingresos:acme",
          "R"
        ],
        [
          "ingresos:beta",
          "G"
        ]
      ],
      "account": "ingresos",
      "type": "revenue",
      "isRevenue": true,
      "isExpense": false,
      "isAsset": false,
      "isEquity": false
    },
    {
      "_why": "A genuinely MIXED subtree has no single type, so it is untyped rather than classified by whichever child sorts first.",
