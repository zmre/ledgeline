# ledgeline: SimpleFIN sync rules for Checking ••1234
skip 1
fields posting_date, amount, merchant, description, memo, id, transacted
date-format %Y-%m-%d
date %posting_date
account1 liabilities:firsttech:visa
account2 expenses:unknown
description %merchant
comment id:%id
if %transacted .
  date2 %transacted
include firsttech-visa.categories.rules
