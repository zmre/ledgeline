<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleName</key>
  <string>Ledgeline</string>
  <key>CFBundleDisplayName</key>
  <string>Ledgeline</string>
  <key>CFBundleExecutable</key>
  <string>ledgeline</string>
  <!-- CFBundleIconName names the layered icon compiled into Assets.car
       (assets/Ledgeline.icon, via scripts/gen-icons.sh); macOS 26+ uses it for
       the light, dark, clear and tinted appearances. Older macOS ignores it and
       falls back to CFBundleIconFile, the flat ledgeline.icns. -->
  <key>CFBundleIconName</key>
  <string>Ledgeline</string>
  <key>CFBundleIconFile</key>
  <string>ledgeline</string>
  <key>CFBundleIdentifier</key>
  <string>com.zmre.ledgeline</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>@version@</string>
  <key>CFBundleVersion</key>
  <string>@version@</string>
  <key>CFBundleSupportedPlatforms</key>
  <array>
    <string>MacOSX</string>
  </array>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.finance</string>
  <key>LSMinimumSystemVersion</key>
  <string>10.15</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © 2026 Patrick Walsh. All rights reserved.</string>
  <!-- File associations, split across two types so the handler ranks can differ.
       `.journal`/`.hledger` are hledger-specific, so we claim Owner and become
       the system default for them. `.ledger`/`.j` are shared territory: Ledger
       CLI tooling owns the former and `.j` is a very generic extension (other
       languages and tools use it), so Alternate lets a user pick Ledgeline via
       Open With without silently stealing the default from whatever already
       claims them. Both types conform to public.plain-text — journals ARE plain
       text, and conforming means Quick Look, Spotlight indexing and generic
       text editors keep working on them.

       `org.ledger-cli.journal` is NOT ours: it is a UTI other apps (text
       editors, notably) import for .journal/.ledger/.hledger/.beancount. When
       two bundles declare a type for the same extension, Launch Services picks
       one, and which one wins can change with each re-registration (every
       Nix/Home Manager rebuild re-registers the app at a new path). A file
       typed as the OTHER UTI then lists only its importer in Open With and
       Ledgeline vanishes from the menu. Claiming the alias too keeps
       Ledgeline offered, and the default, whichever declaration wins. Keep
       this list in step with `DEFAULT_CONTENT_TYPES` in
       crates/ledgeline-server/src/gui_file_assoc.rs (a unit test checks). -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>hledger journal</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>CFBundleTypeIconFile</key>
      <string>ledgeline</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.zmre.ledgeline.journal</string>
        <string>org.ledger-cli.journal</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Ledger journal</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>CFBundleTypeIconFile</key>
      <string>ledgeline</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.zmre.ledgeline.ledger</string>
      </array>
    </dict>
  </array>
  <!-- We EXPORT (rather than import) these UTIs because no system-supplied type
       covers a plain-text accounting journal; exporting is what tells Launch
       Services the extension→UTI mapping these document types refer to. -->
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>com.zmre.ledgeline.journal</string>
      <key>UTTypeDescription</key>
      <string>hledger journal</string>
      <key>UTTypeIconFile</key>
      <string>ledgeline</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.plain-text</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>journal</string>
          <string>hledger</string>
        </array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>com.zmre.ledgeline.ledger</string>
      <key>UTTypeDescription</key>
      <string>Ledger journal</string>
      <key>UTTypeIconFile</key>
      <string>ledgeline</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.plain-text</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>ledger</string>
          <string>j</string>
        </array>
      </dict>
    </dict>
  </array>
</dict>
</plist>
